\begin{enumerate}
    \item Mi hermana y yo estamos estudiando francés. (My sister and I are studying French.)
    \item Tú y yo estamos hablando español. (You and I are speaking Spanish.)
    \item Él y yo estamos tomando el mismo autobús. (Him and I are taking the same bus.)
    \item Yo y mi mamá estamos preparando la cena. (My mom and I are preparing dinner.)
    \item Yo y él estamos viviendo en el mismo edificio. (Him and I are living in the same building.)
\end{enumerate}

\subsection*{Answers}
\begin{enumerate}
\item Correct
\item Incorrect
\item Incorrect
\item Correct
\item Incorrect
\end{enumerate}
