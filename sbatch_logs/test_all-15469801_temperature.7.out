        \item Están cocinando la cena
        \item Estas cocinando la cena
    \end{enumerate}

    \item “They are buying clothes.” (Translation)
    \begin{enumerate}[label=\alph*.]
        \item Están comprando ropa
        \item Estas comprando ropa
        \item Estamos comprando ropa
    \end{enumerate}

    \item “You are working too much.” (Translation)
    \begin{enumerate}[label=\alph*.]
        \item Estás trabajando demasiado
        \item Están trabajando demasiado
        \item Estamos trabajando demasiado
    \end{enumerate}

    \item “He is sleeping.” (Translation)
    \begin{enumerate}[label=\alph*.]
        \item Estás durmiendo
        \item Están durmiendo
        \item Está durmiendo
    \end{enumerate}

    \item “I am thinking about it.” (Translation)
    \begin{enumerate}[label=\alph*.]
        \item Estás pensando en eso
        \item Están pensando en eso
        \item Estoy pensando en eso
    \end{enumerate}
\end{enumerate}

\subsection*{Answers}
\begin{enumerate}
\item Estamos cocinando la cena
\item Están comprando ropa
\item Estás trabajando demasiado
\item Está durmiendo
\item Estoy pensando en eso
\end{enumerate} <<Generation>>
