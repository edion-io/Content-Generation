    \end{enumerate}

    \item Qu'est-ce que la tortue dit qu'elle faisait?
    \begin{enumerate}
        \item[A] Elle regardait le paysage
        \item[B] Elle mangeait des fruits
        \item[C] Elle dansait de l'eau
        \item[D] Elle dormait
    \end{enumerate}

    \item Pourquoi l'oiseau était fatigué?
