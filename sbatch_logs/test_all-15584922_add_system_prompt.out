\begin{enumerate}
\item Zijn je schoenen duur?
\item Zijn je kleren duur?
\item Zijn je sokken duur?
\item Zijn je jurk duur?
\item Zijn je kranten duur?
\item Zijn je boeken duur?
\item Zijn je spijkerbroek duur?
\item Zijn je T-shirt duur?
\item Zijn je korte broek duur?
\item Zijn je sandalen duur?
\end{enumerate}
\end{enumerate}

