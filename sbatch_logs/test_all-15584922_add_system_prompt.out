\item Wij \_\_\_\_\_\_ (rijden) in een nieuwe auto.
\end{enumerate}

\subsection*{Answers}
\begin{enumerate}
\item koken
\item wonen
\item kletsen
\item zingen
\item helpt
\item kletsen
\item schrijft
\item spreekt
\item danst
\item rijden
