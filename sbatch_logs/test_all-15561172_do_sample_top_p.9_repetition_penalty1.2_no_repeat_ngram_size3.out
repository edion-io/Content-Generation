Now use this method to find these products:

\begin{sagesilent}
import random
numbers = list(range(10))
random.shuffle(numbers)

# Select three unique pairs from the shuffled list.
pair_list = []
for i in range(len(numbers) - 1):
    pair_list.append((i,i+1))

three_pairs = random.sample(pair_list, k=3)

product_table = {
"products": [],
"description": "Product table"
}

def create_product_string(num_pair):
num_strs = map(str,num_pair)
return ''.join(num_strs)

for num_pair in three_pairs:
prod = str(num_pair[0]*num_pair[1])
description_line = f'{create_product_string (num_pair)} = '
product_table["products"].append(description_line + prod )

print(product_table)
\end{sageslient} 

