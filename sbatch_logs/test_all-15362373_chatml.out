    \item Elle (se promener)          dans la campagne.
    \item Il (se promener)          dans la campagne.
    \item Tu (se promener)          dans la campagne.
\end{enumerate}

\subsection*{Answers}
\begin{enumerate}
\item est allé
\item as ouvert
\item s'est reposée
\item nous sommes promené(e)s
\item s'est reposée
\item me suis reposé
\item se sont promené(e)s
\item s'est promenée
